# Keep text files LF-normalized across Linux and Windows checkouts.
* text=auto eol=lf

# Never normalize binary artifacts as text.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.zip binary
*.npz binary
*.npy binary
*.parquet binary
*.mp4 binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary
